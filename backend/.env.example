# ==========================================================
# 配置模板：复制为 .env 并填入真实值
# ==========================================================

# 安全
SECRET_KEY=change-me-to-a-random-32-byte-hex

# 数据库（本地开发用 SQLite，生产用 PostgreSQL）
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# 管理员种子账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# DeepSeek LLM
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding 向量化（local=本地 bge-small-zh 无需 Key / siliconflow=需 Key）
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=512
LOCAL_MODEL_PATH=../infra/models/bge-small-zh-v1.5
# SiliconFlow bge-m3（可选模式）
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 向量库 Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb_documents

# Redis（未配置则降级为内存缓存 / 限流内存实现）
REDIS_URL=

# 语义缓存（相似问题直接返回缓存回答，省一次 LLM 调用）
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=200
CACHE_SIMILARITY_THRESHOLD=0.93

# 混合检索 / 重排序
RRF_K=60
# bge-reranker 精排（可选）：下载模型到 LOCAL 路径后设 RERANK_ENABLED=true
RERANK_ENABLED=false
RERANK_MODEL_PATH=../infra/models/bge-reranker-base
RERANK_TOP_N=6

# 接口限流（登录 10/min、问答 20/min，防暴力破解与刷接口）
RATE_LIMIT_ENABLED=true

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 应用
DEBUG=true
